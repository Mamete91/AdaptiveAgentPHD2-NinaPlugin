<UserControl
    x:Class="AdaptiveAgentForPHD2.NinaPlugin.Settings.PluginSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext = PluginSettings (impostato dal DataTemplate _Options) -->
    <StackPanel Margin="10" MaxWidth="560" HorizontalAlignment="Left">

        <TextBlock Text="Adaptive Agent for PHD2 — Impostazioni"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,10" />

        <!-- Percorso Avvia.bat -->
        <TextBlock Text="Percorso del file Avvia.bat dell'Agente"
                   FontWeight="SemiBold"
                   Margin="0,4,0,2" />
        <TextBlock Text="Usato dal pulsante &quot;Avvia Adaptive Agent&quot; nel pannello dockable."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="Sfoglia..."
                    Padding="12,3"
                    Margin="6,0,0,0"
                    Click="OnBrowseClick" />
            <TextBox Text="{Binding AgentBatPath, UpdateSourceTrigger=LostFocus}"
                     VerticalContentAlignment="Center"
                     Padding="4,3" />
        </DockPanel>

        <!-- Intervallo di polling -->
        <TextBlock Text="Intervallo controllo stato Agente (secondi)"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="Ogni quanti secondi il plugin verifica se l'Agente risponde. Valori ammessi: 5–120."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBox Width="80"
                 HorizontalAlignment="Left"
                 Padding="4,3"
                 Text="{Binding HealthCheckIntervalSeconds, UpdateSourceTrigger=LostFocus}" />

        <!-- URL dashboard -->
        <TextBlock Text="URL della dashboard dell'Agente"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="Modificalo solo se hai cambiato la porta dell'Agente. Default: http://localhost:8080"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBox Width="280"
                 HorizontalAlignment="Left"
                 Padding="4,3"
                 Text="{Binding DashboardUrl, UpdateSourceTrigger=LostFocus}" />

        <!-- Inoltro telemetria per-posa all'Agente (v1.3, §42) -->
        <TextBlock Text="Inoltra le metriche per-posa di NINA all'Agente"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="A ogni posa salvata, invia all'Agente HFR, FWHM, conteggio stelle, eccentricità e statistiche immagine (HTTP POST). Opzionale: se l'Agente è offline non succede nulla e NINA non viene mai disturbata. Disattiva per non inviare alcun dato."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <CheckBox Content="Inoltro telemetria attivo"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding ForwardTelemetryToAgent}" />

        <!-- Safety Monitor: consolidamento STAR_LOST (v1.2) -->
        <TextBlock Text="Safety Monitor — consolidamento STAR_LOST (secondi)"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="Tempo per cui STAR_LOST deve persistere prima che il Safety Monitor dichiari unsafe. Default 5 minuti (300). Valori ammessi: 30–1800. Aumentando si riducono i falsi positivi al prezzo di un riconoscimento più lento; diminuendo si rischia di triggerare unsafe su STAR_LOST transienti che l'Agente avrebbe recuperato."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBox Width="80"
                 HorizontalAlignment="Left"
                 Padding="4,3"
                 Text="{Binding StarLostConsolidationSeconds, UpdateSourceTrigger=LostFocus}" />

        <!-- Safety su nubi (NINA), v1.4 §49 N6 -->
        <TextBlock Text="Safety Monitor — Safety su nubi (trasparenza NINA)"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="Se attivo, il Safety Monitor dichiara unsafe (accanto a STAR_LOST) quando la trasparenza NINA resta CLOUD per N poll consecutivi — così NINA mette in pausa la ripresa prima di perdere la stella di guida. Fail-safe: senza telemetria fresca la condizione nubi è neutra (resta solo STAR_LOST). Richiede l'inoltro telemetria attivo e l'Agente in esecuzione."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <CheckBox Content="Safety su nubi attiva"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding CloudSafetyEnabled}" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="CLOUD → unsafe (poll):" VerticalAlignment="Center" Opacity="0.8" />
          <TextBox Width="60" Margin="6,0,14,0" Padding="4,3"
                   Text="{Binding CloudUnsafePolls, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Text="CLEAR/HAZE → safe (poll):" VerticalAlignment="Center" Opacity="0.8" />
          <TextBox Width="60" Margin="6,0,0,0" Padding="4,3"
                   Text="{Binding ClearSafePolls, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>

        <TextBlock Text="Le impostazioni vengono salvate automaticamente."
                   FontSize="10"
                   Opacity="0.6"
                   Margin="0,14,0,0" />
    </StackPanel>
</UserControl>
