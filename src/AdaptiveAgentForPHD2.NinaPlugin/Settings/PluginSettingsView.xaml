<UserControl
    x:Class="AdaptiveAgentForPHD2.NinaPlugin.Settings.PluginSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:AdaptiveAgentForPHD2.NinaPlugin.Localization">

    <!-- DataContext = PluginSettings (impostato dal DataTemplate _Options).
         §60: tutte le stringhe vengono dalle Resource via Loc (indexer bindabile,
         pattern NINA): il cambio lingua aggiorna la pagina LIVE. -->
    <StackPanel Margin="10" MaxWidth="560" HorizontalAlignment="Left">

        <TextBlock Text="{Binding [Settings_Title], Source={x:Static loc:Loc.Instance}}"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,10" />

        <!-- §60 — lingua del plugin -->
        <TextBlock Text="{Binding [Settings_Language_Label], Source={x:Static loc:Loc.Instance}}"
                   FontWeight="SemiBold"
                   Margin="0,4,0,2" />
        <TextBlock Text="{Binding [Settings_Language_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <ComboBox Width="200"
                  HorizontalAlignment="Left"
                  SelectedValuePath="Tag"
                  SelectedValue="{Binding PluginLanguage}">
            <ComboBoxItem Tag=""
                          Content="{Binding [Settings_Language_Follow], Source={x:Static loc:Loc.Instance}}" />
            <ComboBoxItem Tag="en" Content="English" />
            <ComboBoxItem Tag="it" Content="Italiano" />
        </ComboBox>

        <!-- Percorso launcher -->
        <TextBlock Text="{Binding [Settings_BatPath_Label], Source={x:Static loc:Loc.Instance}}"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="{Binding [Settings_BatPath_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="{Binding [Settings_Browse], Source={x:Static loc:Loc.Instance}}"
                    Padding="12,3"
                    Margin="6,0,0,0"
                    Click="OnBrowseClick" />
            <TextBox Text="{Binding AgentBatPath, UpdateSourceTrigger=LostFocus}"
                     VerticalContentAlignment="Center"
                     Padding="4,3" />
        </DockPanel>

        <!-- Intervallo di polling -->
        <TextBlock Text="{Binding [Settings_Interval_Label], Source={x:Static loc:Loc.Instance}}"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="{Binding [Settings_Interval_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBox Width="80"
                 HorizontalAlignment="Left"
                 Padding="4,3"
                 Text="{Binding HealthCheckIntervalSeconds, UpdateSourceTrigger=LostFocus}" />

        <!-- URL dashboard -->
        <TextBlock Text="{Binding [Settings_DashUrl_Label], Source={x:Static loc:Loc.Instance}}"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="{Binding [Settings_DashUrl_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBox Width="280"
                 HorizontalAlignment="Left"
                 Padding="4,3"
                 Text="{Binding DashboardUrl, UpdateSourceTrigger=LostFocus}" />

        <!-- Inoltro telemetria per-posa (§42) -->
        <TextBlock Text="{Binding [Settings_Telemetry_Label], Source={x:Static loc:Loc.Instance}}"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="{Binding [Settings_Telemetry_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <CheckBox Content="{Binding [Settings_Telemetry_Check], Source={x:Static loc:Loc.Instance}}"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding ForwardTelemetryToAgent}" />

        <!-- Safety Monitor: consolidamento STAR_LOST -->
        <TextBlock Text="{Binding [Settings_StarLost_Label], Source={x:Static loc:Loc.Instance}}"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="{Binding [Settings_StarLost_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBox Width="80"
                 HorizontalAlignment="Left"
                 Padding="4,3"
                 Text="{Binding StarLostConsolidationSeconds, UpdateSourceTrigger=LostFocus}" />

        <!-- Safety su nubi (§49 N6 + fix v1.5) -->
        <TextBlock Text="{Binding [Settings_Cloud_Label], Source={x:Static loc:Loc.Instance}}"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="{Binding [Settings_Cloud_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <CheckBox Content="{Binding [Settings_Cloud_Check], Source={x:Static loc:Loc.Instance}}"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding CloudSafetyEnabled}" />
        <!-- §126 — chi giudica il cielo: di default la sola guida; la camera di ripresa
             torna giudice solo se lo si chiede esplicitamente (comportamento fino al 1.13). -->
        <CheckBox Content="{Binding [Settings_CameraJudge_Check], Source={x:Static loc:Loc.Instance}}"
                  HorizontalAlignment="Left"
                  Margin="0,6,0,0"
                  IsChecked="{Binding ImagingCameraUnsafeEnabled}" />
        <TextBlock Text="{Binding [Settings_CameraJudge_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,4" />
        <!-- §60 — tooltip localizzati sui parametri numerici: promemoria del modello mentale
             (accumulatore leaky, gate di attivazione, effetto pratico) nel punto di decisione.
             Contenuto = TextBlock con wrapping esplicito: nessuno style implicito che
             scavalcherebbe il tema tooltip di NINA. -->
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="{Binding [Settings_DegradedPolls], Source={x:Static loc:Loc.Instance}}"
                     VerticalAlignment="Center" Opacity="0.8">
            <TextBlock.ToolTip>
              <TextBlock Text="{Binding [Settings_Tip_DegradedPolls], Source={x:Static loc:Loc.Instance}}"
                         TextWrapping="Wrap" MaxWidth="360" />
            </TextBlock.ToolTip>
          </TextBlock>
          <TextBox Width="60" Margin="6,0,14,0" Padding="4,3"
                   Text="{Binding CloudUnsafePolls, UpdateSourceTrigger=LostFocus}">
            <TextBox.ToolTip>
              <TextBlock Text="{Binding [Settings_Tip_DegradedPolls], Source={x:Static loc:Loc.Instance}}"
                         TextWrapping="Wrap" MaxWidth="360" />
            </TextBox.ToolTip>
          </TextBox>
          <TextBlock Text="{Binding [Settings_ClearPolls], Source={x:Static loc:Loc.Instance}}"
                     VerticalAlignment="Center" Opacity="0.8">
            <TextBlock.ToolTip>
              <TextBlock Text="{Binding [Settings_Tip_ClearPolls], Source={x:Static loc:Loc.Instance}}"
                         TextWrapping="Wrap" MaxWidth="360" />
            </TextBlock.ToolTip>
          </TextBlock>
          <TextBox Width="60" Margin="6,0,0,0" Padding="4,3"
                   Text="{Binding ClearSafePolls, UpdateSourceTrigger=LostFocus}">
            <TextBox.ToolTip>
              <TextBlock Text="{Binding [Settings_Tip_ClearPolls], Source={x:Static loc:Loc.Instance}}"
                         TextWrapping="Wrap" MaxWidth="360" />
            </TextBox.ToolTip>
          </TextBox>
        </StackPanel>

        <!-- Persistenza sull'indice (v1.5 §2) -->
        <CheckBox Content="{Binding [Settings_Index_Check], Source={x:Static loc:Loc.Instance}}"
                  HorizontalAlignment="Left"
                  Margin="0,8,0,0"
                  IsChecked="{Binding UseIndexCloudLogic}" />
        <TextBlock Text="{Binding [Settings_Index_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,4" />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding [Settings_AccumBelow], Source={x:Static loc:Loc.Instance}}"
                     VerticalAlignment="Center" Opacity="0.8">
            <TextBlock.ToolTip>
              <TextBlock Text="{Binding [Settings_Tip_AccumBelow], Source={x:Static loc:Loc.Instance}}"
                         TextWrapping="Wrap" MaxWidth="360" />
            </TextBlock.ToolTip>
          </TextBlock>
          <TextBox Width="60" Margin="6,0,14,0" Padding="4,3"
                   Text="{Binding CloudIndexAccumulateBelow, UpdateSourceTrigger=LostFocus}">
            <TextBox.ToolTip>
              <TextBlock Text="{Binding [Settings_Tip_AccumBelow], Source={x:Static loc:Loc.Instance}}"
                         TextWrapping="Wrap" MaxWidth="360" />
            </TextBox.ToolTip>
          </TextBox>
          <TextBlock Text="{Binding [Settings_DrainAbove], Source={x:Static loc:Loc.Instance}}"
                     VerticalAlignment="Center" Opacity="0.8">
            <TextBlock.ToolTip>
              <TextBlock Text="{Binding [Settings_Tip_DrainAbove], Source={x:Static loc:Loc.Instance}}"
                         TextWrapping="Wrap" MaxWidth="360" />
            </TextBlock.ToolTip>
          </TextBlock>
          <TextBox Width="60" Margin="6,0,0,0" Padding="4,3"
                   Text="{Binding CloudIndexDrainAbove, UpdateSourceTrigger=LostFocus}">
            <TextBox.ToolTip>
              <TextBlock Text="{Binding [Settings_Tip_DrainAbove], Source={x:Static loc:Loc.Instance}}"
                         TextWrapping="Wrap" MaxWidth="360" />
            </TextBox.ToolTip>
          </TextBox>
        </StackPanel>

        <!-- Telemetria stantia (v1.5 §1) -->
        <CheckBox Content="{Binding [Settings_Stale_Check], Source={x:Static loc:Loc.Instance}}"
                  HorizontalAlignment="Left"
                  Margin="0,8,0,0"
                  IsChecked="{Binding StaleUnsafeEnabled}" />
        <TextBlock Text="{Binding [Settings_Stale_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,4" />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding [Settings_StalePolls], Source={x:Static loc:Loc.Instance}}"
                     VerticalAlignment="Center" Opacity="0.8">
            <TextBlock.ToolTip>
              <TextBlock Text="{Binding [Settings_Tip_StalePolls], Source={x:Static loc:Loc.Instance}}"
                         TextWrapping="Wrap" MaxWidth="360" />
            </TextBlock.ToolTip>
          </TextBlock>
          <TextBox Width="60" Margin="6,0,0,0" Padding="4,3"
                   Text="{Binding StaleUnsafePolls, UpdateSourceTrigger=LostFocus}">
            <TextBox.ToolTip>
              <TextBlock Text="{Binding [Settings_Tip_StalePolls], Source={x:Static loc:Loc.Instance}}"
                         TextWrapping="Wrap" MaxWidth="360" />
            </TextBox.ToolTip>
          </TextBox>
        </StackPanel>

        <!-- Agente irraggiungibile (v1.5 §5) -->
        <CheckBox Content="{Binding [Settings_AgentLost_Check], Source={x:Static loc:Loc.Instance}}"
                  HorizontalAlignment="Left"
                  Margin="0,8,0,0"
                  IsChecked="{Binding AgentLostUnsafeEnabled}" />
        <TextBlock Text="{Binding [Settings_AgentLost_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,4" />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding [Settings_AgentLostPolls], Source={x:Static loc:Loc.Instance}}"
                     VerticalAlignment="Center" Opacity="0.8">
            <TextBlock.ToolTip>
              <TextBlock Text="{Binding [Settings_Tip_AgentLostPolls], Source={x:Static loc:Loc.Instance}}"
                         TextWrapping="Wrap" MaxWidth="360" />
            </TextBlock.ToolTip>
          </TextBlock>
          <TextBox Width="60" Margin="6,0,0,0" Padding="4,3"
                   Text="{Binding AgentLostUnsafePolls, UpdateSourceTrigger=LostFocus}">
            <TextBox.ToolTip>
              <TextBlock Text="{Binding [Settings_Tip_AgentLostPolls], Source={x:Static loc:Loc.Instance}}"
                         TextWrapping="Wrap" MaxWidth="360" />
            </TextBox.ToolTip>
          </TextBox>
        </StackPanel>

        <!-- v1.7 §58 — ciclo di vita -->
        <TextBlock Text="{Binding [Settings_Lifecycle_Label], Source={x:Static loc:Loc.Instance}}"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <CheckBox Content="{Binding [Settings_AutoLaunch_Check], Source={x:Static loc:Loc.Instance}}"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding AutoLaunchEnabled}" />
        <TextBlock Text="{Binding [Settings_AutoLaunch_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,4" />
        <CheckBox Content="{Binding [Settings_ManageExt_Check], Source={x:Static loc:Loc.Instance}}"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding ManageExternalAgent}" />
        <TextBlock Text="{Binding [Settings_ManageExt_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,4" />

        <!-- §68 — osservabilità del canale di guida (non la sua qualità) -->
        <TextBlock Text="{Binding [Settings_GuideObs_Label], Source={x:Static loc:Loc.Instance}}"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <CheckBox Content="{Binding [Settings_GuideObs_Check], Source={x:Static loc:Loc.Instance}}"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding GuideUnobservableEnabled}" />
        <TextBlock Text="{Binding [Settings_GuideObs_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,4" />
        <StackPanel Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Opacity="0.8"
                     Text="{Binding [Settings_GuideSilence], Source={x:Static loc:Loc.Instance}}"
                     ToolTip="{Binding [Settings_GuideSilence_Tip], Source={x:Static loc:Loc.Instance}}" />
          <TextBox Width="60" Margin="6,0,14,0" Padding="4,3"
                   ToolTip="{Binding [Settings_GuideSilence_Tip], Source={x:Static loc:Loc.Instance}}"
                   Text="{Binding GuideSilenceSeconds, UpdateSourceTrigger=LostFocus}" />
          <TextBlock VerticalAlignment="Center" Opacity="0.8"
                     Text="{Binding [Settings_GuidePolls], Source={x:Static loc:Loc.Instance}}"
                     ToolTip="{Binding [Settings_GuidePolls_Tip], Source={x:Static loc:Loc.Instance}}" />
          <TextBox Width="60" Margin="6,0,0,0" Padding="4,3"
                   ToolTip="{Binding [Settings_GuidePolls_Tip], Source={x:Static loc:Loc.Instance}}"
                   Text="{Binding GuideUnobservablePolls, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>

        <!-- §76 — il canale guida può anticipare l'unsafe -->
        <CheckBox Content="{Binding [Settings_SkyDegrade_Check], Source={x:Static loc:Loc.Instance}}"
                  HorizontalAlignment="Left"
                  Margin="0,14,0,0"
                  IsChecked="{Binding SkyDegradingAccumulateEnabled}" />
        <TextBlock Text="{Binding [Settings_SkyDegrade_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,4" />
        <!-- §79 — soglia PROPRIA del percorso rapido: tarare la persistenza del cielo
             (impostazione "Degradato -> unsafe") non deve rallentare questa. -->
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                    IsEnabled="{Binding SkyDegradingAccumulateEnabled}">
          <TextBlock Text="{Binding [Settings_SkyDegrade_Polls], Source={x:Static loc:Loc.Instance}}"
                     VerticalAlignment="Center" Opacity="0.8">
            <TextBlock.ToolTip>
              <TextBlock Text="{Binding [Settings_Tip_SkyDegradePolls], Source={x:Static loc:Loc.Instance}}"
                         TextWrapping="Wrap" MaxWidth="360" />
            </TextBlock.ToolTip>
          </TextBlock>
          <TextBox Width="60" Margin="6,0,0,0" Padding="4,3"
                   Text="{Binding SkyDegradingUnsafePolls, UpdateSourceTrigger=LostFocus}">
            <TextBox.ToolTip>
              <TextBlock Text="{Binding [Settings_Tip_SkyDegradePolls], Source={x:Static loc:Loc.Instance}}"
                         TextWrapping="Wrap" MaxWidth="360" />
            </TextBox.ToolTip>
          </TextBox>
        </StackPanel>

        <!-- §71 — gate della sonda sul canale guida -->
        <CheckBox Content="{Binding [Settings_ProbeGate_Check], Source={x:Static loc:Loc.Instance}}"
                  HorizontalAlignment="Left"
                  Margin="0,14,0,0"
                  IsChecked="{Binding ProbeChannelGateEnabled}" />
        <TextBlock Text="{Binding [Settings_ProbeGate_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,4" />

        <!-- §72 — protezione meridiano -->
        <TextBlock Text="{Binding [Settings_Meridian_Label], Source={x:Static loc:Loc.Instance}}"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <CheckBox Content="{Binding [Settings_Meridian_Check], Source={x:Static loc:Loc.Instance}}"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding MeridianProtectionEnabled}" />
        <TextBlock Text="{Binding [Settings_Meridian_Help], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,4" />
        <StackPanel Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Opacity="0.8"
                     Text="{Binding [Settings_MeridianLead], Source={x:Static loc:Loc.Instance}}"
                     ToolTip="{Binding [Settings_MeridianLead_Tip], Source={x:Static loc:Loc.Instance}}" />
          <TextBox Width="60" Margin="6,0,0,0" Padding="4,3"
                   ToolTip="{Binding [Settings_MeridianLead_Tip], Source={x:Static loc:Loc.Instance}}"
                   Text="{Binding MeridianLeadMinutes, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>

        <!-- §58-ter — mini-guida al recovery automatico -->
        <TextBlock Text="{Binding [Settings_Recovery_Title], Source={x:Static loc:Loc.Instance}}"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="{Binding [Settings_Recovery_Intro], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,2" />
        <TextBlock FontFamily="Consolas"
                   FontSize="11"
                   Margin="8,2,0,2"
                   Text="Trigger On Unsafe&#10; └ Before Waiting For Safety&#10;    └ Recovery probe (Adaptive Agent)" />
        <TextBlock Text="{Binding [Settings_Recovery_Body], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,0" />

        <TextBlock Text="{Binding [Settings_SavedAuto], Source={x:Static loc:Loc.Instance}}"
                   FontSize="10"
                   Opacity="0.6"
                   Margin="0,14,0,0" />
    </StackPanel>
</UserControl>
