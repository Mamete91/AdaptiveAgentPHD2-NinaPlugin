<UserControl
    x:Class="AdaptiveAgentForPHD2.NinaPlugin.Settings.PluginSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext = PluginSettings (impostato dal DataTemplate _Options) -->
    <StackPanel Margin="10" MaxWidth="560" HorizontalAlignment="Left">

        <TextBlock Text="Adaptive Agent for PHD2 — Settings"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,10" />

        <!-- Percorso Avvia.bat -->
        <TextBlock Text="Path to the Agent launcher (Avvia.bat)"
                   FontWeight="SemiBold"
                   Margin="0,4,0,2" />
        <TextBlock Text="Used by the &quot;Launch Adaptive Agent&quot; button in the dockable panel."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="Browse..."
                    Padding="12,3"
                    Margin="6,0,0,0"
                    Click="OnBrowseClick" />
            <TextBox Text="{Binding AgentBatPath, UpdateSourceTrigger=LostFocus}"
                     VerticalContentAlignment="Center"
                     Padding="4,3" />
        </DockPanel>

        <!-- Intervallo di polling -->
        <TextBlock Text="Agent status polling interval (seconds)"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="How often the plugin checks whether the Agent responds. Allowed range: 5–120."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBox Width="80"
                 HorizontalAlignment="Left"
                 Padding="4,3"
                 Text="{Binding HealthCheckIntervalSeconds, UpdateSourceTrigger=LostFocus}" />

        <!-- URL dashboard -->
        <TextBlock Text="Agent dashboard URL"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="Change only if you changed the Agent's port. Default: http://localhost:8080"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBox Width="280"
                 HorizontalAlignment="Left"
                 Padding="4,3"
                 Text="{Binding DashboardUrl, UpdateSourceTrigger=LostFocus}" />

        <!-- Inoltro telemetria per-posa all'Agente (v1.3, §42) -->
        <TextBlock Text="Forward NINA per-exposure metrics to the Agent"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="On every saved exposure, sends HFR, star count and image statistics to the Agent (HTTP POST). Optional: if the Agent is offline nothing happens and NINA is never disturbed. Disable to send no data."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <CheckBox Content="Telemetry forwarding enabled"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding ForwardTelemetryToAgent}" />

        <!-- Safety Monitor: consolidamento STAR_LOST (v1.2) -->
        <TextBlock Text="Safety Monitor — STAR_LOST consolidation (seconds)"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="How long STAR_LOST must persist before the Safety Monitor reports unsafe. Default 5 minutes (300). Allowed range: 30–1800. Higher values reduce false positives at the cost of slower detection; lower values risk triggering on transient STAR_LOST events the Agent would have recovered."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBox Width="80"
                 HorizontalAlignment="Left"
                 Padding="4,3"
                 Text="{Binding StarLostConsolidationSeconds, UpdateSourceTrigger=LostFocus}" />

        <!-- Safety su nubi (NINA), v1.4 §49 N6 + fix v1.5 -->
        <TextBlock Text="Safety Monitor — cloud safety (NINA transparency)"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="When enabled, the Safety Monitor reports unsafe (alongside STAR_LOST) when sky transparency stays degraded — so NINA can pause the imaging run before the guide star is lost. Requires telemetry forwarding and the Agent running."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <CheckBox Content="Cloud safety enabled"
                  HorizontalAlignment="Left"
                  IsChecked="{Binding CloudSafetyEnabled}" />
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Degraded → unsafe (polls):" VerticalAlignment="Center" Opacity="0.8" />
          <TextBox Width="60" Margin="6,0,14,0" Padding="4,3"
                   Text="{Binding CloudUnsafePolls, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Text="Clear → safe (polls):" VerticalAlignment="Center" Opacity="0.8" />
          <TextBox Width="60" Margin="6,0,0,0" Padding="4,3"
                   Text="{Binding ClearSafePolls, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>

        <!-- v1.5 fix N6 §2 — persistenza sull'indice -->
        <CheckBox Content="Use transparency index persistence (recommended)"
                  HorizontalAlignment="Left"
                  Margin="0,8,0,0"
                  IsChecked="{Binding UseIndexCloudLogic}" />
        <TextBlock Text="Accumulates degradation while the transparency index is low and drains it while the sky is clear; brief HAZE bounces no longer reset the cloud timer. Unchecked = legacy logic (consecutive CLOUD polls on the discrete state)."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,4" />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Accumulate below index:" VerticalAlignment="Center" Opacity="0.8" />
          <TextBox Width="60" Margin="6,0,14,0" Padding="4,3"
                   Text="{Binding CloudIndexAccumulateBelow, UpdateSourceTrigger=LostFocus}" />
          <TextBlock Text="Drain above index:" VerticalAlignment="Center" Opacity="0.8" />
          <TextBox Width="60" Margin="6,0,0,0" Padding="4,3"
                   Text="{Binding CloudIndexDrainAbove, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>

        <!-- v1.5 fix N6 §1 — telemetria stantia -->
        <CheckBox Content="Report unsafe on stale telemetry under a degraded sky"
                  HorizontalAlignment="Left"
                  Margin="0,8,0,0"
                  IsChecked="{Binding StaleUnsafeEnabled}" />
        <TextBlock Text="If NINA telemetry stops arriving (beyond the adaptive freshness window — the normal gap between exposures does NOT trigger this) while the session is active and the last known sky was degraded, the Safety Monitor escalates to unsafe instead of silently disabling cloud safety."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,4" />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Stale → unsafe (polls):" VerticalAlignment="Center" Opacity="0.8" />
          <TextBox Width="60" Margin="6,0,0,0" Padding="4,3"
                   Text="{Binding StaleUnsafePolls, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>

        <!-- v1.5 fix N6 §5 — agente irraggiungibile -->
        <CheckBox Content="Report unsafe if the Agent becomes unreachable during an active session"
                  HorizontalAlignment="Left"
                  Margin="0,8,0,0"
                  IsChecked="{Binding AgentLostUnsafeEnabled}" />
        <TextBlock Text="Losing the Agent means losing observation of both sky and guiding — a risk condition. The monitor stays connected and escalates to unsafe with its own hysteresis (it never flips to safe by disconnecting). With guiding intentionally stopped, an offline Agent raises no alarm."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,2,0,4" />
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Agent lost → unsafe (polls):" VerticalAlignment="Center" Opacity="0.8" />
          <TextBox Width="60" Margin="6,0,0,0" Padding="4,3"
                   Text="{Binding AgentLostUnsafePolls, UpdateSourceTrigger=LostFocus}" />
        </StackPanel>

        <TextBlock Text="Settings are saved automatically."
                   FontSize="10"
                   Opacity="0.6"
                   Margin="0,14,0,0" />
    </StackPanel>
</UserControl>
