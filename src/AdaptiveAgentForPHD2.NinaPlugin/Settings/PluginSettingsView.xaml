<UserControl
    x:Class="AdaptiveAgentForPHD2.NinaPlugin.Settings.PluginSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DataContext = PluginSettings (impostato dal DataTemplate _Options) -->
    <StackPanel Margin="10" MaxWidth="560" HorizontalAlignment="Left">

        <TextBlock Text="Adaptive Agent for PHD2 — Impostazioni"
                   FontWeight="Bold"
                   FontSize="14"
                   Margin="0,0,0,10" />

        <!-- Percorso Avvia.bat -->
        <TextBlock Text="Percorso del file Avvia.bat dell'Agente"
                   FontWeight="SemiBold"
                   Margin="0,4,0,2" />
        <TextBlock Text="Usato dal pulsante &quot;Avvia Adaptive Agent&quot; nel pannello dockable."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Content="Sfoglia..."
                    Padding="12,3"
                    Margin="6,0,0,0"
                    Click="OnBrowseClick" />
            <TextBox Text="{Binding AgentBatPath, UpdateSourceTrigger=LostFocus}"
                     VerticalContentAlignment="Center"
                     Padding="4,3" />
        </DockPanel>

        <!-- Intervallo di polling -->
        <TextBlock Text="Intervallo controllo stato Agente (secondi)"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="Ogni quanti secondi il plugin verifica se l'Agente risponde. Valori ammessi: 5–120."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBox Width="80"
                 HorizontalAlignment="Left"
                 Padding="4,3"
                 Text="{Binding HealthCheckIntervalSeconds, UpdateSourceTrigger=LostFocus}" />

        <!-- URL dashboard -->
        <TextBlock Text="URL della dashboard dell'Agente"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="Modificalo solo se hai cambiato la porta dell'Agente. Default: http://localhost:8080"
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBox Width="280"
                 HorizontalAlignment="Left"
                 Padding="4,3"
                 Text="{Binding DashboardUrl, UpdateSourceTrigger=LostFocus}" />

        <!-- Safety Monitor: consolidamento STAR_LOST (v1.2) -->
        <TextBlock Text="Safety Monitor — consolidamento STAR_LOST (secondi)"
                   FontWeight="SemiBold"
                   Margin="0,14,0,2" />
        <TextBlock Text="Tempo per cui STAR_LOST deve persistere prima che il Safety Monitor dichiari unsafe. Default 5 minuti (300). Valori ammessi: 30–1800. Aumentando si riducono i falsi positivi al prezzo di un riconoscimento più lento; diminuendo si rischia di triggerare unsafe su STAR_LOST transienti che l'Agente avrebbe recuperato."
                   FontSize="10"
                   Opacity="0.7"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />
        <TextBox Width="80"
                 HorizontalAlignment="Left"
                 Padding="4,3"
                 Text="{Binding StarLostConsolidationSeconds, UpdateSourceTrigger=LostFocus}" />

        <TextBlock Text="Le impostazioni vengono salvate automaticamente."
                   FontSize="10"
                   Opacity="0.6"
                   Margin="0,14,0,0" />
    </StackPanel>
</UserControl>
